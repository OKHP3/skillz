flowchart TD
    Start["SKILL.md exists\nvalid frontmatter + basic sections"] --> Skel["skeleton"]

    Skel --> C{"Workflow followable\nby an agent alone?"}
    C -->|"No"| Imp["Revise instructions\nor references"]
    Imp --> C
    C -->|"Yes"| Draft["draftable"]

    Draft --> D{"Real task completed\nusing this skill?"}
    D -->|"No"| Run["Complete a task\nusing the skill"]
    Run --> D
    D -->|"Yes"| Use["usable"]

    Use --> E{"Worked examples +\nvalidation checklist +\nknown failures?"}
    E -->|"No"| Ev["Add evidence\nartifacts"]
    Ev --> E
    E -->|"Yes"| Valid["validated"]

    Valid --> F{"Release-tagged\nand cataloged?"}
    F -->|"No"| Rel["Tag release +\nregistry entry"]
    Rel --> F
    F -->|"Yes"| Pub["published"]

    classDef maturity fill:#5b21b6,stroke:#ddd6fe,stroke-width:2px,color:#fff
    classDef gate fill:#1e3a5f,stroke:#93c5fd,stroke-width:2px,color:#e0f2fe
    classDef action fill:#064e3b,stroke:#6ee7b7,stroke-width:2px,color:#d1fae5
    classDef start fill:#374151,stroke:#9ca3af,stroke-width:2px,color:#f9fafb

    class Skel,Draft,Use,Valid,Pub maturity
    class C,D,E,F gate
    class Imp,Run,Ev,Rel action
    class Start start
