{
  "name": "@workspace/forge",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "ALLOW_SHALLOW_CATALOG_BUILD=1 node scripts/build-catalog.js && node scripts/build-activity.mjs",
    "dev": "vite --config vite.config.ts --host 0.0.0.0",
    "prebuild": "ALLOW_SHALLOW_CATALOG_BUILD=1 node scripts/build-catalog.js && node scripts/build-activity.mjs",
    "build": "vite build --config vite.config.ts",
    "serve": "vite preview --config vite.config.ts --host 0.0.0.0",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@replit/vite-plugin-cartographer": "catalog:",
    "@replit/vite-plugin-dev-banner": "catalog:",
    "@replit/vite-plugin-runtime-error-modal": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "fuse.js": "^7.5.0",
    "lucide-react": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-router-dom": "^7.18.1",
    "vite": "catalog:",
    "vitest": "^3.2.0"
  }
}
