# Shell and automation files must remain executable and parse consistently on
# Windows, macOS, Linux, and GitHub-hosted Linux runners.
*.sh text eol=lf
*.py text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Keep the portable Replit executor mirror byte-identical across hosts.
replit/okhp3-replit-task-executor/** text=auto eol=lf

# Foundry current-core receipts hash bytes; keep them stable across hosts.
universal/okhp3-skill-foundry/** text=auto eol=lf
.agents/skills/okhp3-skill-foundry/** text=auto eol=lf
# Preserve historical experiment source bytes, outside current-core receipts.
universal/okhp3-skill-foundry/workspace/** -text
.agents/skills/okhp3-skill-foundry/workspace/** -text

# These existing mixed-ending files retain their bytes during identity edits.
artifacts/forge/src/data/stacks.ts whitespace=cr-at-eol
context-extraction/okhp3-thread-extract-grok/evals/evals.json whitespace=cr-at-eol

# Preserve recovered historical source bytes.
docs/archive/local-work-2026-09-20/SKILLZ-FORGE-REPLIT-BUILD-DIRECTIVE.md -text
